{
  "name": "chasing",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "clean": "node build/clean-output.mjs",
    "build:clean": "npm run clean && npm run build",
    "verify:release": "node build/verify-clean-build.mjs",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "art:environment-orm": "node tools/art_pipeline/generate_environment_runtime_orm.mjs",
    "art:character-runtime": "node tools/art_pipeline/optimize_character_runtime.mjs",
    "art:character-runtime:check": "node tools/art_pipeline/optimize_character_runtime.mjs --check",
    "art:character-lod1": "node tools/art_pipeline/build_character_lod1.mjs",
    "art:character-bootstrap": "node tools/art_pipeline/build_character_bootstrap.mjs",
    "art:theme-bootstrap": "node tools/art_pipeline/build_theme_bootstrap.mjs",
    "art:environment-bootstrap": "node tools/art_pipeline/optimize_environment_bootstrap_ktx2.mjs",
    "art:runtime-ktx2": "node tools/art_pipeline/optimize_runtime_ktx2.mjs",
    "art:runtime-ktx2:check": "node tools/art_pipeline/optimize_runtime_ktx2.mjs --check",
    "art:runtime-gate": "node tools/art_pipeline/validate_runtime_assets.mjs",
    "art:runtime-gate:check": "node tools/art_pipeline/validate_runtime_assets.mjs --check",
    "qa:active-mechanic": "node scripts/active-mechanic-qa.mjs",
    "qa:character-bootstrap": "node scripts/character-bootstrap-visual-qa.mjs",
    "qa:deep-gameplay": "node scripts/deep-gameplay-visual-qa.mjs",
    "qa:library-gold": "node scripts/library-gold-visual-qa.mjs",
    "qa:locker-maze": "node scripts/locker-maze-qa.mjs",
    "qa:m2-size": "node scripts/m2-size-audit.mjs",
    "qa:m2-size:check": "node scripts/m2-size-audit.mjs --check",
    "qa:m3-baseline": "node scripts/m3-render-baseline.mjs",
    "qa:m3-shadow": "node scripts/m3-shadow-visual-qa.mjs",
    "qa:stealth-systems": "node scripts/stealth-systems-visual-qa.mjs",
    "qa:theme-bootstrap": "node scripts/theme-bootstrap-visual-qa.mjs",
    "test": "npm run build:clean && npm run test:unit",
    "test:unit": "node --experimental-strip-types --test tests/*.test.mjs",
    "audit:production": "node build/audit-dependencies.mjs production",
    "audit:tooling": "node build/audit-dependencies.mjs tooling",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "next": "16.2.11",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.47.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-react": "6.0.4",
    "@vitejs/plugin-rsc": "0.5.30",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.11",
    "gltf-validator": "2.0.0-dev.3.10",
    "gltfpack": "1.2.0",
    "react-server-dom-webpack": "19.2.8",
    "sharp": "0.35.2",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.1.5",
    "wrangler": "4.114.0"
  },
  "overrides": {
    "postcss": "8.5.23",
    "sharp": "0.35.2"
  },
  "type": "module"
}
